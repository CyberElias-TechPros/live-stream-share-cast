# ---------------------------------------------------------------------------
# Frontend environment (Vite)
# ---------------------------------------------------------------------------

# REST base for the Cloudflare Worker API.
#   local dev       -> /api   (proxied by Vite to http://127.0.0.1:8787)
#   split hosting   -> https://<your-worker>.workers.dev/api
VITE_API_BASE=/api

# WebSocket base. Leave empty to derive it from VITE_API_BASE / the page origin.
# VITE_WS_BASE=wss://<your-worker>.workers.dev/api

# Only used by `vite.config.ts` — where the dev proxy forwards /api.
# VITE_API_TARGET=http://127.0.0.1:8787
