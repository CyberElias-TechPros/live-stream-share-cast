{
  "name": "imlive-worker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "I'm Live — Cloudflare Worker API (D1 + Durable Objects)",
  "scripts": {
    "dev": "wrangler dev --port 8787 --ip 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply imlive --local",
    "db:migrate:remote": "wrangler d1 migrations apply imlive --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "@types/node": "^22.20.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.131.1"
  }
}
