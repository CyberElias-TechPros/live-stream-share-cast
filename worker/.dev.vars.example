# ---------------------------------------------------------------------------
# Local secrets for `wrangler dev` — copy to `.dev.vars` (git-ignored).
#
#   cp .dev.vars.example .dev.vars
#
# Only the "required" block must be present. Everything below it is optional:
# leave a group commented out and the matching feature simply reports itself as
# "needs keys" in `GET /api/health` and the admin console — nothing breaks.
# ---------------------------------------------------------------------------

# ---------------------------- required -------------------------------------
# Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
# Protects POST /api/admin/cleanup (manual cron trigger).
CLEANUP_TOKEN=dev-cleanup-token

ENVIRONMENT=development
ALLOWED_ORIGINS=*

# ---------------------------- brand / legal --------------------------------
APP_NAME=I'm Live
APP_TAGLINE=Share the moment, live.
APP_URL=http://localhost:8080
# APP_VERSION=1.0.0
# SUPPORT_EMAIL=support@example.com
# DOCS_URL=https://example.com/docs
# STATUS_URL=https://status.example.com
# SOCIAL_TWITTER=
# SOCIAL_GITHUB=
# SOCIAL_DISCORD=
# SOCIAL_YOUTUBE=
# SOCIAL_INSTAGRAM=
# TERMS_VERSION=2026-01-01
# PRIVACY_VERSION=2026-01-01
# LEGAL_ENTITY=
# LEGAL_JURISDICTION=

# ---------------------------- tuning ---------------------------------------
RECORDING_RETENTION_HOURS=6
STALE_STREAM_MINUTES=5
SIGNED_URL_TTL=3600
MAX_UPLOAD_BYTES=524288000
# MAX_AVATAR_BYTES=5242880
# MAX_CHAT_MESSAGE_LENGTH=500
# MAX_TITLE_LENGTH=140
# MAX_BIO_LENGTH=500
# MAX_TAGS=8
# MAX_STREAMS_PER_USER=50
# MAX_SCHEDULED_PER_USER=20
# CHAT_HISTORY_PAGE_SIZE=100
# LOG_LEVEL=info

# ---------------------------- feature flags --------------------------------
# FEATURE_SIGNUPS=true
# FEATURE_REQUIRE_EMAIL_VERIFICATION=false
# FEATURE_CHAT=true
# FEATURE_SCHEDULING=true
# FEATURE_VOD=true
# FEATURE_CLIPS=true
# FEATURE_TIPS=false
# FEATURE_WEBHOOKS=true
# FEATURE_API_TOKENS=true
# FEATURE_SCHEDULE_REMINDERS=true
# FEATURE_MOD_CONSOLE=true
# FEATURE_DATA_EXPORT=true
# FEATURE_ACCOUNT_DELETION=true
# FEATURE_PUSH=false
# FEATURE_CLIENT_ERRORS=true

# ---------------------------- email outbox ---------------------------------
# Providers: resend | postmark | sendgrid | mailchannels | webhook | none
# EMAIL_PROVIDER=resend
# EMAIL_FROM=noreply@example.com
# EMAIL_FROM_NAME=I'm Live
# EMAIL_REPLY_TO=support@example.com
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=
# POSTMARK_MESSAGE_STREAM=outbound
# SENDGRID_API_KEY=
# MAILCHANNELS_API_KEY=
# EMAIL_WEBHOOK_URL=
# EMAIL_WEBHOOK_TOKEN=
# EMAIL_BATCH_SIZE=25
# EMAIL_MAX_ATTEMPTS=5
# EMAIL_FANOUT_LIMIT=200
# Send every message here instead of the real recipient (staging).
# EMAIL_OVERRIDE_TO=

# ---------------------------- WebRTC / TURN --------------------------------
# STUN_URLS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302
# TURN_PROVIDER=cloudflare | static | none
# TURN_KEY_ID=
# TURN_KEY_API_TOKEN=
# TURN_CREDENTIAL_TTL=3600
# TURN_STATIC_USERNAME=
# TURN_STATIC_PASSWORD=
# TURN_URLS=turn:turn.example.com:3478

# ---------------------------- captcha --------------------------------------
# CAPTCHA_PROVIDER=turnstile | hcaptcha | none
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# HCAPTCHA_SITE_KEY=
# HCAPTCHA_SECRET_KEY=

# ---------------------------- payments -------------------------------------
# PAYMENT_PROVIDER=stripe | webhook | none
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYMENT_WEBHOOK_URL=
# PAYMENT_SUCCESS_URL=
# PAYMENT_CANCEL_URL=
# PAYMENTS_CURRENCY=usd
# MIN_TIP_CENTS=100
# MAX_TIP_CENTS=50000
# PLATFORM_FEE_PERCENT=0

# ---------------------------- Web Push (VAPID) -----------------------------
# Generate: npx web-push generate-vapid-keys
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=
# PUSH_SUBJECT=mailto:support@example.com

# ---------------------------- observability --------------------------------
# ANALYTICS_PROVIDER=none | plausible | umami | posthog | ga4 | custom
# ANALYTICS_SITE_ID=
# ANALYTICS_SCRIPT_URL=
# SENTRY_DSN=
# ERROR_REPORT_SAMPLE_RATE=1
